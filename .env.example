# Application Configuration
PROJECT_NAME="OpenBizFlow"
ENVIRONMENT="development"

# Security Secrets (Generate using openssl rand -hex 32)
SECRET_KEY=""
# Optional: generate using cryptography.fernet.Fernet.generate_key().decode()
ENCRYPTION_KEY=""

# Database & Cache
DATABASE_URL="postgresql://openbizflow:openbizflow_secret@localhost:5434/openbizflow_db"
# Local SQLite fallback for instant zero-dependency execution:
# DATABASE_URL="sqlite:///./openbizflow.db"

REDIS_URL="redis://localhost:6380/0"

# Security & SSRF
ALLOW_PRIVATE_IPS="false"
